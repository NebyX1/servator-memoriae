# Copiar a .env (bootstrap lo conserva). Nunca commitear .env real.
# La instalación local arranca sin login. Para publicar, ver docs/deployment/COOLIFY.md.
FLASK_ENV=development
LOCAL_TEST_MODE=1
FRONT_BIND=127.0.0.1
SECRET_KEY=cambiar-por-64-hex-generados-con-bootstrap
DATABASE_URL=postgresql+psycopg2://servator:servator@postgres:5432/servator
POSTGRES_USER=servator
POSTGRES_PASSWORD=servator
POSTGRES_DB=servator
REDIS_URL=redis://redis:6379/0
RQ_QUEUE=servator
# S3 compatible: local reproducible por defecto (filesystem).
# Opcional: perfil s3 (adobe/s3mock:5.2.3) o endpoint existente con S3_USE_LOCAL=0.
S3_ENDPOINT=http://s3mock:9090
S3_ACCESS_KEY=minioadmin
S3_SECRET_KEY=minioadmin
S3_BUCKET=servator
S3_REGION=us-east-1
S3_USE_LOCAL=1
# Rutas dentro de contenedor
DATA_DIR=/data
MODEL_DIR=/models
MODEL_CACHE_DIR=/models/cache
# Subidas
MAX_UPLOAD_MB=512
MAX_PAGES_PER_FILE=500
# Dispositivo: auto|cpu|cuda (bootstrap escribe .device y lo inyecta)
DEVICE_MODE=cpu
CORS_ORIGINS=http://localhost:8787
FRONT_PORT=8787
ADMIN_EMAIL=admin@local
# ADMIN_PASSWORD=definir-solo-en-entorno-no-commitear
# torch wheels: CPU por defecto; Blackwell/cu130 para GPU
TORCH_INDEX_CPU=https://download.pytorch.org/whl/cpu
TORCH_INDEX_CU126=https://download.pytorch.org/whl/cu126
TORCH_INDEX_CU130=https://download.pytorch.org/whl/cu130
TORCH_INDEX_URL=https://download.pytorch.org/whl/cpu
